# Crowscap Mobile environment variables
# Copy this file to .env and fill in real values

# Backend API base URL
EXPO_PUBLIC_BACKEND_URL=https://api.crowscap.xyz

# Google OAuth client IDs (separate clients from web — type: iOS and Android)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=YOUR_IOS_GOOGLE_CLIENT_ID
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=YOUR_ANDROID_GOOGLE_CLIENT_ID
